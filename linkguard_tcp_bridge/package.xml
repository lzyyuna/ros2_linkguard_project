<?xml version="1.0"?>
<package format="3">
  <name>linkguard_tcp_bridge</name>
  <version>0.1.0</version>
  <description>TCP gateway between a Windows operator station and LinkGuard ROS 2 actions.</description>
  <maintainer email="student@example.com">student</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>linkguard_interfaces</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>linkguard_bringup</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
